{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "UserResponse",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "username",
    "firstName",
    "lastName",
    "email",
    "remoteAddr"
  ],
  "properties": {
    "id": {
      "type": "integer",
      "minimum": 1
    },
    "username": {
      "type": "string",
      "minLength": 1
    },
    "firstName": {
      "type": "string"
    },
    "lastName": {
      "type": "string"
    },
    "email": {
      "type": "string"
    },
    "remoteAddr": {
      "type": "string"
    }
  }
}